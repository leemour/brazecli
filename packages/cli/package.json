{
  "name": "@leemour/brazecli",
  "version": "0.3.0",
  "description": "Braze REST API command line interface for AI agents, automation and people.",
  "license": "MIT",
  "author": "Viacheslav Ptsarev",
  "homepage": "https://github.com/leemour/brazecli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leemour/brazecli.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/leemour/brazecli/issues"
  },
  "keywords": [
