{
  "name": "brazecli-core",
  "version": "0.4.0",
  "private": true,
  "description": "The Braze client inside brazecli. Web Platform APIs only — no Node. Not published separately.",
  "license": "MIT",
  "author": "Viacheslav Ptsarev",
  "homepage": "https://github.com/leemour/brazecli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leemour/brazecli.git",
    "directory": "packages/core"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "p-queue": "^9.0.0",
    "valibot": "^1.1.0"
  }
}
